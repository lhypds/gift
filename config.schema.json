{
    "description": "Shared settings and the webhooks server.",
    "options": [
        {
            "key": "github_webhook_secret",
            "env": "GITHUB_WEBHOOK_SECRET",
            "type": "secret",
            "description": "Shared secret configured on the GitHub webhook (Settings -> Webhooks -> Secret). ./setup.sh generates one when it is empty."
        },
        {
            "key": "webhook_url",
            "env": "GIFT_WEBHOOK_URL",
            "type": "string",
            "description": "Complete public delivery URL used by `gift create`, the /hooks/github path included."
        },
        {
            "key": "pm2_name",
            "env": "PM2_NAME",
            "type": "string",
            "default": "gift-webhooks",
            "description": "Name the server runs under in PM2."
        },
        {
            "key": "port",
            "env": "PORT",
            "type": "number",
            "min": 1,
            "default": 3999,
            "description": "Port the server listens on."
        },
        {
            "key": "serve_host",
            "env": "GIFT_SERVE_HOST",
            "type": "string",
            "default": "127.0.0.1",
            "description": "Address the server binds."
        },
        {
            "key": "serve_path",
            "env": "GIFT_SERVE_PATH",
            "type": "string",
            "default": "/hooks/github",
            "description": "Endpoint GitHub delivers to."
        },
        {
            "key": "serve_log",
            "env": "GIFT_SERVE_LOG",
            "type": "string",
            "default": "hooks.log",
            "description": "Where the server appends its log. A relative path is relative to the project folder; `off` keeps everything on the console."
        }
    ]
}
