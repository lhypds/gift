# Copied to .env by ./setup.sh. .env is git-ignored — keep secrets here only.

# --- gift serve ---------------------------------------------------------------
# Shared secret configured on the GitHub webhook (Settings -> Webhooks -> Secret).
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Defaults for `gift serve` (command-line flags win over these).
GIFT_SERVE_HOST=127.0.0.1
GIFT_SERVE_PORT=3001
GIFT_SERVE_PATH=/hooks/github

# --- gift list ----------------------------------------------------------------
# Repositories to search when --repos is not given (comma separated).
GIFT_REPOS=

# GitHub login whose pull requests are listed when --author is not given.
GIFT_AUTHOR=lhypds
