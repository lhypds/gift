{
  "log": "hooks.log",
  "hooks": [
    {
      "name": "restart-on-push",
      "trigger": {
        "type": "github",
        "repo": "YOUR_NAME/YOUR_REPOSITORY",
        "events": ["push"],
        "branches": ["main"],
        "secretEnv": "GITHUB_WEBHOOK_SECRET"
      },
      "run": "/opt/myapp/restart.sh",
      "args": [],
      "cwd": "/opt/myapp",
      "detach": false,
      "enabled": true
    },
    {
      "name": "save-copied-todo",
      "trigger": {
        "type": "clipboard",
        "match": "^TODO:",
        "matchType": "regex",
        "interval": 1000
      },
      "run": "node /opt/myapp/save-todo.js",
      "args": [],
      "cwd": "/opt/myapp",
      "detach": false,
      "enabled": false
    },
    {
      "name": "status-page-changed",
      "trigger": {
        "type": "website",
        "url": "https://example.com/status.json",
        "method": "GET",
        "on": "change",
        "match": "",
        "matchType": "any",
        "interval": 60000,
        "timeout": 10000,
        "credentials": {
          "localStorage": {
            "sample_auth_store": {
              "accessToken": "xxx",
              "refreshToken": "xxx"
            }
          },
          "sessionStorage": {},
          "cookies": {},
          "headers": {
            "x-sample-authorization": {
              "from": "localStorage",
              "key": "sample_auth_store",
              "field": "accessToken"
            }
          },
          "refresh": {
            "url": "https://example.com/api/v1/auth/refresh",
            "on": [401],
            "body": {
              "refresh_token": {
                "from": "localStorage",
                "key": "sample_auth_store",
                "field": "refreshToken"
              }
            },
            "expect": { "code": 0 },
            "save": {
              "data.access_token": {
                "from": "localStorage",
                "key": "sample_auth_store",
                "field": "accessToken"
              },
              "data.refresh_token": {
                "from": "localStorage",
                "key": "sample_auth_store",
                "field": "refreshToken"
              }
            }
          }
        },
        "saveLastResponse": true
      },
      "run": "/opt/myapp/alert.sh",
      "args": [],
      "cwd": "/opt/myapp",
      "detach": false,
      "enabled": false
    },
    {
      "name": "reload-config",
      "trigger": {
        "type": "file",
        "path": "/opt/myapp/conf",
        "pattern": "*.yml",
        "events": ["add", "change"],
        "recursive": true,
        "debounce": 500
      },
      "run": "git -C /opt/myapp pull && bash /opt/myapp/reload.sh",
      "args": [],
      "cwd": "/opt/myapp",
      "detach": false,
      "enabled": false
    }
  ]
}
