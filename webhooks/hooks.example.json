{
  "log": "hooks.log",
  "hooks": [
    {
      "name": "restart-example",
      "repo": "YOUR_NAME/YOUR_REPOSITORY",
      "events": ["push"],
      "branches": ["main"],
      "run": "/opt/myapp/some.sh",
      "args": [],
      "cwd": "/opt/myapp",
      "detach": false,
      "secretEnv": "GITHUB_WEBHOOK_SECRET"
    }
  ]
}
