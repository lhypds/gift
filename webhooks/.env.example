# Settings for `gift serve` only. Copied to .env in this folder by ./setup.sh;
# that .env is git-ignored — keep the secret here and nowhere else.
#
# Read whether the server is started by `gift serve` or directly with
# `node webhooks/server.js`. A value already in the environment wins, which is
# how the systemd unit in README.txt supplies the secret in production.

# Shared secret configured on the GitHub webhook (Settings -> Webhooks -> Secret).
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# PM2 process name and listening port, read by ecosystem.config.cjs and by
# ./start.sh, ./stop.sh and ./restart.sh. PORT is also the port `gift serve`
# binds when it is run without PM2.
PM2_NAME=gift-webhooks
PORT=3001

# Defaults for the listener (command-line flags win over these).
GIFT_SERVE_HOST=127.0.0.1
GIFT_SERVE_PATH=/hooks/github
