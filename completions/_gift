#compdef gift
# gift-completion — zsh completion for the gift CLI. Installed by ./install.sh,
# removed by ./uninstall.sh. Command names come from `gift commands`, so new
# command folders complete without touching this file.
#
# Works two ways: autoloaded from fpath (the `#compdef` line above), or sourced
# from ~/.zshrc after compinit has run, which is what ./install.sh sets up.

_gift() {
    local -a entries

    if (( CURRENT == 3 )) && [[ ${words[2]} == completion ]]; then
        _values 'shell' zsh bash
        return
    fi

    if (( CURRENT == 2 )) || { (( CURRENT == 3 )) && [[ ${words[2]} == help ]]; }; then
        entries=("${(@f)$(command gift commands --describe 2>/dev/null)}")
        entries=(${entries:#})
        if (( ${#entries} )); then
            _describe -t gift-commands 'gift command' entries
        fi
        # Never fall through to filenames here: a command name is expected, and
        # offering the folders in the current directory only misleads.
        return
    fi

    _files
}

if [[ ${funcstack[1]} == _gift ]]; then
    _gift "$@"                      # autoloaded by the completion system
elif (( $+functions[compdef] )); then
    compdef _gift gift              # sourced from ~/.zshrc
fi
