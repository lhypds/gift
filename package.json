{
  "name": "gift",
  "version": "0.0.1",
  "description": "git functions — one function per folder, plus a GitHub webhook server",
  "license": "MIT",
  "bin": {
    "gift": "bin/gift.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "cli.js",
    "commands",
    "functions/**/*.sh",
    "functions/**/.env.example",
    "functions/**/README.*",
    "functions.js",
    "utils",
    "webhooks/*.js",
    "webhooks/*.cjs",
    "webhooks/*.sh",
    "webhooks/*.txt",
    "webhooks/*.example.json",
    "webhooks/.env.example",
    "VERSION"
  ]
}
