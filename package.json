{
  "name": "gift",
  "description": "GitHub webhook server with additional Git and GitHub helper functions",
  "license": "MIT",
  "bin": {
    "gift": "bin/gift.js"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "vite build --config web/vite.config.js",
    "dev": "vite --config web/vite.config.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "files": [
    "bin",
    "cli.js",
    "commands",
    "functions/**/*.sh",
    "functions/**/*.js",
    "functions/**/config.schema.json",
    "functions/**/README.*",
    "functions.js",
    "config.schema.json",
    "utils",
    "serve.js",
    "web",
    "ecosystem.config.cjs",
    "start.sh",
    "stop.sh",
    "restart.sh",
    "README.txt",
    "hooks.example.json",
    "VERSION"
  ]
}
