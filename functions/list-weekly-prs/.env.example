# Settings for `gift list-weekly-prs` only. Copied to .env in this folder by ./setup.sh;
# that .env is git-ignored, so these values stay yours.
#
# Both are defaults for the matching flag — `--repos` and `--author` still win,
# as does a value already in the environment. Leave a line commented out to fall
# back to ../../.env.

# Repositories to search when --repos is not given (comma separated).
#GIFT_REPOS=owner/repo1,owner/repo2

# GitHub login whose pull requests are listed when --author is not given.
#GIFT_AUTHOR=octocat
