{
    "description": "Watch every git repository under one folder in a live table.",
    "options": [
        {
            "key": "repo_root",
            "env": "GIFT_REPO_MASTER_REPO_ROOT",
            "type": "path",
            "description": "Folder holding the repositories to watch, as an absolute path. Without it repo-master watches the directory it is run in."
        },
        {
            "key": "depth",
            "env": "GIFT_REPO_MASTER_DEPTH",
            "type": "number",
            "min": 1,
            "default": 4,
            "description": "How many folders deep to look for repositories."
        },
        {
            "key": "refresh",
            "env": "GIFT_REPO_MASTER_REFRESH",
            "type": "number",
            "min": 1,
            "default": 30,
            "description": "Seconds between full sweeps: a rescan for repositories that came or went, plus a git refresh of every row."
        },
        {
            "key": "shell_command",
            "env": "GIFT_REPO_MASTER_SHELL",
            "type": "string",
            "description": "Command behind `goto folder` — the shell started in the chosen repository. Without it, your login shell from $SHELL.",
            "advanced": true
        },
        {
            "key": "code_command",
            "env": "GIFT_REPO_MASTER_CODE",
            "type": "string",
            "default": "code",
            "description": "Command behind `open with code` and the `e` key — `cursor` and `windsurf` take a folder the same way.",
            "advanced": true
        },
        {
            "key": "vim_command",
            "env": "GIFT_REPO_MASTER_VIM",
            "type": "string",
            "default": "vim",
            "description": "Command behind `open with vim` and the `v` key — `nvim`, `hx` and the like take a folder the same way.",
            "advanced": true
        },
        {
            "key": "claude_command",
            "env": "GIFT_REPO_MASTER_CLAUDE",
            "type": "string",
            "default": "claude",
            "description": "Command behind `open with claude code`.",
            "advanced": true
        },
        {
            "key": "codex_command",
            "env": "GIFT_REPO_MASTER_CODEX",
            "type": "string",
            "default": "codex",
            "description": "Command behind `open with codex`.",
            "advanced": true
        },
        {
            "key": "claude_add_dir",
            "env": "GIFT_REPO_MASTER_CLAUDE_ADD_DIR",
            "type": "string",
            "default": "--add-dir",
            "description": "The option `open with claude code` passes the repositories picked after the main one, once per repository. Set it to false to open the main project alone.",
            "advanced": true
        },
        {
            "key": "codex_add_dir",
            "env": "GIFT_REPO_MASTER_CODEX_ADD_DIR",
            "type": "string",
            "default": "--add-dir",
            "description": "The same for `open with codex`, for a version that spells the option differently.",
            "advanced": true
        }
    ]
}
