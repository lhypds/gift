# Settings for `gift recur` only. Copied to .env in this folder by ./setup.sh;
# that .env is git-ignored, so these values stay yours.
#
# The value below is the default for `--dir` — that flag still wins, as does a
# value already in the environment. Leave the line commented out to search the
# directory you are standing in, and to fall back to ../../.env.

# Folder to search for git repositories. A leading ~ is expanded; a relative
# path is resolved against the current directory.
#GIFT_PULL_DIR=~/code
