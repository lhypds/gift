.vscode
.DS_Store
# Local settings and state. config.json holds the webhook secret. gift no longer
# reads .env at all; the line stays so that one left over from an older
# installation cannot be committed by accident.
config.json
config.json.tmp
.env
hooks.json
# Left behind only if `gift hook create` or `delete` dies mid-write
hooks.json.tmp

# Build / release output
node_modules/
release/
dist/

# Logs, the webhook server's hooks.log and its rotated hooks.log.1 included
*.log
*.log.[0-9]

# Recent-deliveries state, mirrored to disk so a restart doesn't lose it
deliveries.json
deliveries.json.tmp

*.swp
